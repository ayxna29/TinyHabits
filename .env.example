# Copy this file to .env and fill in your own Supabase project credentials.
# Find these in your Supabase project: Settings -> API.
# The anon/public key is safe to use here — it's meant for client-side code,
# protected by Row Level Security policies on your tables, not by secrecy.
# Never put your service_role key in this file or in any client-side code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
